# PostgreSQL (see docker-compose.yml: docker compose up -d)
DATABASE_URL="postgresql://aegis:aegis@localhost:5432/aegis"
# Optional: set to 1 so `npm run build` skips `prisma migrate deploy` when no DB (e.g. local UI work).
# SKIP_PRISMA_MIGRATE_ON_BUILD=1
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Staff logins are database users (username + password). After first migrate, create the first admin:
#   ADMIN_USERNAME=you ADMIN_PASSWORD='secure-pass' npm run create-admin
# Optional: ADMIN_DISPLAY_NAME="Display Name"

# Public URL when using Cloudflare Tunnel or any HTTPS reverse proxy (no trailing slash).
# Required for correct auth callbacks when the app is not at http://localhost:3000.
# Example quick tunnel: AUTH_URL="https://abc-xyz.trycloudflare.com"
# Example custom domain: AUTH_URL="https://aegis.yourdomain.com"
# AUTH_URL="https://aegis.example.com"

# Electron desktop shell (optional; default http://127.0.0.1:3000)
# Or use aegis-server.json next to the .exe with: { "serverUrl": "https://aegis.yourdomain.com" }
# AEGIS_SERVER_URL="http://127.0.0.1:3000"
