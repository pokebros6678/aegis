generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  COM
  SUSPECTED_COM
  ROBLOX
  NSFW
}

enum CaseCategory {
  COMPLIANCE_REPORTING
  ANALYTICS
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditActorRole {
  MEMBER
  ADMIN
}

enum StaffRole {
  ADMIN
  MEMBER
}

model StaffUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         StaffRole
  disabled     Boolean   @default(false)
  displayName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
  casePosts CasePost[]
}

model AuditLog {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  action      AuditLogAction
  entityType  String
  entityId    String
  actorRole   AuditActorRole
  actorUserId String?
  actorUser   StaffUser?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model NameBlacklist {
  id               String   @id @default(cuid())
  phrase           String
  phraseNormalized String   @unique
  createdAt        DateTime @default(now())
}

model Player {
  id          String   @id @default(cuid())
  discordId   String   @unique
  discordUser String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  affiliations        Affiliation[]
  organizationMembers OrganizationMember[]
  cases               Case[]
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members         OrganizationMember[]
  relations       OrganizationRelation[] @relation("OrgRelations")
  relationsAsPeer OrganizationRelation[] @relation("OrgRelationPeer")
  intel           OrganizationIntel[]
  locations       OrganizationLocation[]
  affiliations    Affiliation[]
  cases           Case[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playerId       String?
  player         Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  alias          String?
  role           String?
  notes          String?
}

model OrganizationRelation {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation("OrgRelations", fields: [organizationId], references: [id], onDelete: Cascade)
  peerOrganizationId String?
  peerOrganization   Organization? @relation("OrgRelationPeer", fields: [peerOrganizationId], references: [id], onDelete: SetNull)
  externalLabel      String?
  relationKind       String?
  notes              String?
}

model OrganizationIntel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrganizationLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  address        String?      @db.Text
  kind           String?
  acquiredAt     DateTime?    @db.Date
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Affiliation {
  id             String       @id @default(cuid())
  playerId       String
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String?
  notes          String?
}

model Case {
  id             String       @id @default(cuid())
  caseNumber     String       @unique
  category       CaseCategory
  seq            Int
  title          String
  body           String       @db.Text
  playerId       String?
  player         Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  posts CasePost[]

  @@unique([category, seq])
}

model CasePost {
  id           String     @id @default(cuid())
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorUser   StaffUser? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String     @db.Text
  createdAt    DateTime   @default(now())
}
