# PostgreSQL (see docker-compose.yml: docker compose up -d)
DATABASE_URL="postgresql://aegis:aegis@localhost:5432/aegis"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AEGIS_STAFF_PASSWORD="change-me"

# Electron desktop shell (optional; default http://127.0.0.1:3000)
# Or use aegis-server.json next to the .exe with: { "serverUrl": "https://aegis.yourdomain.com" }
# AEGIS_SERVER_URL="http://127.0.0.1:3000"
