generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  MILITIA
  CRIME_FAMILY
  STREET_GANG
  MOTORCYCLE_CLUB
  CARTEL
}

model Player {
  id          String   @id @default(cuid())
  ssn         String   @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles               Vehicle[]
  affiliations           Affiliation[] @relation("PlayerAffiliations")
  employment             EmploymentRecord[]
  linkedFromAffiliations Affiliation[] @relation("RelatedPlayer")
  organizationMembers    OrganizationMember[]
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members          OrganizationMember[]
  relations        OrganizationRelation[] @relation("OrgRelations")
  relationsAsPeer  OrganizationRelation[] @relation("OrgRelationPeer")
  intel            OrganizationIntel[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playerId       String?
  player         Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  alias          String?
  role           String?
  notes          String?
}

model OrganizationRelation {
  id                   String        @id @default(cuid())
  organizationId       String
  organization         Organization  @relation("OrgRelations", fields: [organizationId], references: [id], onDelete: Cascade)
  peerOrganizationId   String?
  peerOrganization     Organization? @relation("OrgRelationPeer", fields: [peerOrganizationId], references: [id], onDelete: SetNull)
  externalLabel        String?
  relationKind         String?
  notes                String?
}

model OrganizationIntel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Vehicle {
  id       String  @id @default(cuid())
  playerId String
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  plate    String?
  model    String?
  color    String?
  notes    String?
}

model Affiliation {
  id                String  @id @default(cuid())
  playerId          String
  player            Player  @relation("PlayerAffiliations", fields: [playerId], references: [id], onDelete: Cascade)
  name              String
  role              String?
  notes             String?
  relatedPlayerId   String?
  relatedPlayer     Player? @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id], onDelete: SetNull)
}

model EmploymentRecord {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  employer  String
  title     String?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  notes     String?
}
